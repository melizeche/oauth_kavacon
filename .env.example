# Copiar a .env y ajustar. Valores de laboratorio: NO reutilizar en produccion.
#
#   cp .env.example .env
#
# AUTHENTIK_SECRET_KEY: generar uno con:  openssl rand -base64 48

AUTHENTIK_SECRET_KEY=CAMBIAME-openssl-rand-base64-48

# Postgres (lo usan el contenedor postgresql y authentik).
POSTGRES_USER=authentik
POSTGRES_DB=authentik
POSTGRES_PASSWORD=authentik-lab-db-password

# Admin bootstrap (solo primer arranque).
AUTHENTIK_BOOTSTRAP_PASSWORD=akadmin-lab
AUTHENTIK_BOOTSTRAP_TOKEN=lab-bootstrap-token
AUTHENTIK_BOOTSTRAP_EMAIL=admin@lab.local
